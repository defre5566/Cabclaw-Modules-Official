{
  "name": "todo",
  "purpose": "待办提醒：按到期时刻推送提醒，支持内置数据源与 Obsidian 库（双数据源，共享层统一）",
  "spec": "规范.md",
  "enabled": false,
  "schedule": [
    {"every": "1m"}
  ],
  "retry": {"interval_seconds": 60, "max": 0},
  "settings_schema": [
    {
      "section": "数据源",
      "desc": "内置数据源 = 模块自管 JSON（modules/todo/tasks/，agent 维护，推荐）；Obsidian = 扫描你的库目录下所有 .md 的 Tasks 任务行，带日期标注（📅）的才算待办，⏰ 时间标记为本产品扩展（Tasks 原生无时间字段）。单数据源，切换不迁移旧数据。",
      "fields": [
        {"key": "data_source", "type": "select",
         "options": [{"value": "internal", "label": "内置数据源"},
                     {"value": "vault", "label": "Obsidian"}],
         "default": "internal", "desc": "任务数据来源"},
        {"key": "vault_path", "type": "path", "default": "",
         "desc": "Obsidian 库目录（绝对路径或以 ~ 开头）",
         "show_when": {"data_source": "vault"},
         "required_when": {"data_source": "vault"}}
      ]
    },
    {
      "section": "标签",
      "desc": "标签词表白名单。内置模式 agent 写标签从词表选；Obsidian 模式读取时按前缀提取，写回跟随你的既有前缀（兼容不吞并）。",
      "fields": [
        {"key": "tags_vocab", "type": "tags",
         "default": ["工作", "学习", "生活", "家庭", "购物", "健康", "娱乐"],
         "desc": "标签词表（每行一个）"},
        {"key": "allow_new_tag", "type": "boolean", "default": false,
         "desc": "允许添加词表之外的新标签"},
        {"key": "extract_tags", "type": "boolean", "default": true,
         "desc": "Obsidian 读取时提取标签进共享数据",
         "show_when": {"data_source": "vault"}},
        {"key": "tag_prefix", "type": "string", "default": "",
         "desc": "标签前缀（如 #todo/；留空 = 不提取无前缀标签）",
         "show_when": {"data_source": "vault"}}
      ]
    }
  ],
  "settings": {
    "data_source": "internal",
    "vault_path": "",
    "tags_vocab": ["工作", "学习", "生活", "家庭", "购物", "健康", "娱乐"],
    "allow_new_tag": false,
    "extract_tags": true,
    "tag_prefix": ""
  }
}
