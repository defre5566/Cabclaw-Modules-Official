{
  "name": "Planner",
  "bridge_compat": ["0.1"],
  "purpose": "早晚报聚合模块（晨间早报 + 晚间复盘）：聚合任务/天气/节假日/倒计时/简报，agent 加工成口语化文案",
  "spec": "规范.md",
  "schedule_from_settings": [
    {
      "phase": "morning",
      "time_field": "morning_time",
      "enabled_field": "planner_on"
    },
    {
      "phase": "evening",
      "time_field": "evening_time",
      "enabled_field": "planner_on"
    }
  ],
  "job_template": "job.template.json",
  "retry": {
    "interval_seconds": 900,
    "max": 3
  },
  "settings_schema": [
    {
      "section": "早晚报",
      "desc": "总开关与推送时刻；晚报可单独关闭。",
      "fields": [
        {
          "key": "planner_on",
          "type": "boolean",
          "default": true,
          "label": "早晚报总开关"
        },
        {
          "key": "morning_time",
          "type": "string",
          "default": "08:30",
          "label": "早报时刻 （如 08:30）"
        },
        {
          "key": "evening_on",
          "type": "boolean",
          "default": true,
          "label": "晚报开关",
          "desc": "可单独关闭晚间复盘"
        },
        {
          "key": "evening_time",
          "type": "string",
          "default": "21:00",
          "label": "晚报时刻 （如 21:00）"
        }
      ]
    },
    {
      "section": "信息简报",
      "desc": "每日按所选方向生成信息简报，早报前 5 分钟自动生成并附要点与原文文件；预设方向只读，自定义方向在网页导入。",
      "fields": [
        {
          "key": "briefing_on",
          "type": "boolean",
          "default": false,
          "label": "简报开关",
          "desc": "关闭后不再生成简报，早报不带简报段"
        },
        {
          "key": "briefing_topics",
          "type": "choice",
          "max": 3,
          "default": [
            "热点"
          ],
          "label": "简报方向",
          "desc": "最多选 3 个"
        }
      ]
    },
    {
      "section": "地方性数据",
      "desc": "按位置自动显示对应开关：内蒙古显示花粉，沿海省份显示台风。",
      "fields": [
        {
          "key": "pollen_on",
          "type": "boolean",
          "default": false,
          "label": "花粉浓度",
          "desc": "仅内蒙古生效",
          "show_when_service": "pollen"
        },
        {
          "key": "typhoon_on",
          "type": "boolean",
          "default": false,
          "label": "台风动态",
          "desc": "仅沿海省份生效",
          "show_when_service": "typhoon"
        }
      ]
    }
  ]
}